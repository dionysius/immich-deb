Package: immich
Architecture: all
Depends: immich-machine-learning,
         immich-server,
         ${misc:Depends},
# Recommends are installed by default unless explicitly excluded, which is
# a valid choice if the databases are run externally
Recommends: immich-db-reqs,
            redis-server,
Suggests: immich-cli,
Description: Self-hosted photo and video management solution - All-In-One
 Easily back up, organize, and manage your photos on your own server. immich
 helps you browse, search and organize your photos and videos with ease,
 without sacrificing your privacy.
 .
 This metapackage installs all immich server components along with the
 PostgreSQL database including extensions and Redis server.

Package: immich-common
Architecture: all
Pre-Depends: ${misc:Pre-Depends},
Depends: ${misc:Depends},
Recommends: ${misc:Recommends},
Description: Self-hosted photo and video management solution - common files
 Easily back up, organize, and manage your photos on your own server. immich
 helps you browse, search and organize your photos and videos with ease,
 without sacrificing your privacy.
 .
 This package contains common files shared between immich components,
 including the system user, group, and configuration directory.

Package: immich-server
Architecture: any
Pre-Depends: ${misc:Pre-Depends},
Depends: imagemagick,
         immich-common,
         immich-geo-data,
         immich-web-data (= ${source:Version}),
         jellyfin-ffmpeg7 | ffmpeg,
         libheif-plugin-libde265,
         libvips42t64 (>= 8.18.7),
         nodejs (>= 24),
         ${misc:Depends},
         ${perl:Depends},
         ${shlibs:Depends},
Recommends: immich-machine-learning,
            libmimalloc3 | libmimalloc2.0,
            ${misc:Recommends},
Built-Using: ${misc:Built-Using},
Description: Self-hosted photo and video management solution - main server
 Easily back up, organize, and manage your photos on your own server. immich
 helps you browse, search and organize your photos and videos with ease,
 without sacrificing your privacy.
 .
 This package contains the main immich server which handles the backend API,
 database operations, media processing, and serves the web interface.

Package: immich-machine-learning
Architecture: all
Pre-Depends: ${misc:Pre-Depends},
Depends: immich-common,
         immich-machine-learning-custom | immich-machine-learning-backend,
         ${misc:Depends},
Recommends: libmimalloc3 | libmimalloc2.0,
            ${misc:Recommends},
Built-Using: ${misc:Built-Using},
Description: Self-hosted photo and video management solution - ML server
 Easily back up, organize, and manage your photos on your own server. immich
 helps you browse, search and organize your photos and videos with ease,
 without sacrificing your privacy.
 .
 This package contains the machine learning server which handles AI-powered
 features such as facial recognition and object detection.
 .
 Facial recognition uses models from the InsightFace project, downloaded at
 runtime. Their license does not permit redistributing these models or using
 them commercially.

Package: immich-machine-learning-custom
Architecture: amd64 arm64
Depends: immich-machine-learning (= ${source:Version}),
         g++,
         git,
         libgl-dev,
         ${misc:Depends},
         ${shlibs:Depends},
Conflicts: immich-machine-learning-backend,
Replaces: immich-machine-learning (<< ${source:Version}),
          immich-machine-learning-backend,
Breaks: immich-machine-learning (<< ${source:Version}),
Provides: immich-machine-learning-backend (= ${binary:Version}),
Built-Using: ${misc:Built-Using},
Description: Self-hosted photo and video management solution - ML uv backend
 Easily back up, organize, and manage your photos on your own server. immich
 helps you browse, search and organize your photos and videos with ease,
 without sacrificing your privacy.
 .
 This package runs the machine learning server with uv, which downloads the
 python runtime and libraries for the configured DEVICE on the first start
 and after upgrades. uv and the DEVICE are fully configurable through the
 service environment.

Package: immich-machine-learning-venv
Architecture: amd64 arm64
Depends: ${ml:Depends},
         ${misc:Depends},
Built-Using: ${misc:Built-Using},
Description: Self-hosted photo and video management solution - ML python runtime
 Easily back up, organize, and manage your photos on your own server. immich
 helps you browse, search and organize your photos and videos with ease,
 without sacrificing your privacy.
 .
 This package contains the bundled python runtime and the libraries shared by
 the prebuilt machine learning backends on its python version.

Package: immich-machine-learning-cpu
Architecture: amd64 arm64
Depends: immich-machine-learning (= ${source:Version}),
         ${ml:Depends},
         ${misc:Depends},
Conflicts: immich-machine-learning-backend,
Replaces: immich-machine-learning-backend,
