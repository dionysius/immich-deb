+  onReady(name: ImmichWorker) {
+    this.ready.add(name);
+
+    if (Object.keys(this.workers).every((worker) => this.ready.has(worker as ImmichWorker))) {
+      this.onAllReady();
+    }
+  }
+
+  /**
+   * Every running worker is ready to serve
+   */
+  onAllReady() {
+    if (process.env.NOTIFY_SOCKET) {
+      this.notifySystemd();
+    }
+  }
+
+  /**
+   * Tell systemd (Type=notify) that startup finished
+   */
+  private notifySystemd() {
+    // node cannot send to the AF_UNIX datagram socket itself
+    execFile('systemd-notify', ['--ready'], (error) => {
+      if (error) {
+        console.error(`systemd-notify failed: ${error}`);
+      }
+    });
+  }
